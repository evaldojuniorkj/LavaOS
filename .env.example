# Copie para .env.local e ajuste. Nunca versione credenciais reais.
# Os valores abaixo batem com o `docker compose up -d --wait` local (porta 55432 só em loopback).
DATABASE_URL=postgres://lavaos_app:app_local_dev@127.0.0.1:55432/lavaos_dev
MIGRATION_DATABASE_URL=postgres://lavaos_owner:owner_local_dev@127.0.0.1:55432/lavaos_dev
# Banco destrutivo de testes: nome lavaos_test, host local
TEST_DATABASE_URL=postgres://lavaos_app:app_local_dev@127.0.0.1:55432/lavaos_test
# Mínimo de 32 caracteres (ex.: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
LAVAOS_PILOT_SLUG=piloto
# development | test | production
LAVAOS_MODE=development
