# Copie para .env.local e ajuste. Nunca versione credenciais reais.
DATABASE_URL=postgres://lavaos_app:troque@localhost:5432/lavaos
MIGRATION_DATABASE_URL=postgres://lavaos_owner:troque@localhost:5432/lavaos
# Banco destrutivo de testes: nome lavaos_test, host local
TEST_DATABASE_URL=postgres://lavaos_app:troque@localhost:5432/lavaos_test
# Mínimo de 32 caracteres (ex.: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
LAVAOS_PILOT_SLUG=piloto
# development | test | production
LAVAOS_MODE=development
